# ================================================================
# Harvey AI Sales Agent — Local-First Environment Configuration
# EDXSO Assignment 2 — Strictly Zero Paid Cloud LLM Services
# ================================================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173"]

# Persistence (SQLite WAL)
DB_PATH=data/sellbird.db

# Local AI Inference (Ollama)
# Strictly zero paid cloud APIs (No OpenAI, Anthropic, Gemini, Groq)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60.0

# Local Embeddings (SentenceTransformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Offline / Air-Gap Mode Flag
OFFLINE_MODE=false

# Direct SMTP Outbound Mailer (or Mock)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=sales@harvey.local
MOCK_SMTP=true
